# Сборка: src/build.py. HTTPS, без www, 404, сжатие, кэш, переадресация старых адресов
AddDefaultCharset UTF-8
Options -Indexes
AddType image/webp .webp
AddType font/woff2 .woff2
ErrorDocument 404 /incom-audit/404.html

<IfModule mod_rewrite.c>
RewriteEngine On
# если хостинг снимает HTTPS на прокси и условие зацикливает, заменить %{HTTPS} на %{HTTP:X-Forwarded-Proto} !https
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^greenorangeptftm\.github\.io$ [NC]
RewriteRule ^ https://greenorangeptftm.github.io/incom-audit%{REQUEST_URI} [R=301,L]
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType text/html "access plus 0 seconds"
ExpiresByType text/css "access plus 1 year"
ExpiresByType application/javascript "access plus 1 year"
ExpiresByType image/webp "access plus 30 days"
ExpiresByType image/jpeg "access plus 30 days"
ExpiresByType image/png "access plus 30 days"
ExpiresByType image/svg+xml "access plus 30 days"
ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

